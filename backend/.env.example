# Live_DBMS_AI backend environment variables.
# This file is a key and format reference; the backend does not load .env files.
# Inject values through the process, IDE, or deployment secret provider.

# Local development only. Production must not use the local profile because it
# disables target DB TLS.
SPRING_PROFILES_ACTIVE=local

# Part A: system database (PostgreSQL 16 from docker-compose.yml).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/monitoring_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Part A: Redis event streams.
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
# Required outside the isolated local environment.
SPRING_REDIS_PASSWORD=

# Part A: collector and retention.
APP_COLLECTOR_ENABLED=true
APP_COLLECTOR_FIXED_RATE_MS=5000
# 1~365.
APP_METRICS_RETENTION_DAYS=30

# Part B: auth, RBAC, credential encryption, and target policy.
# JSON object: kid -> base64 secret. Never commit actual key material.
JWT_SIGNING_KEYS=
JWT_ACTIVE_KID=
# JSON object: integer version -> base64-encoded exactly 32-byte AES key.
DB_CONFIG_ENCRYPTION_KEYS=
DB_CONFIG_ACTIVE_KEY_VERSION=
PUBLIC_ORIGIN=http://localhost:5173
AUTH_SECURE_COOKIES=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
DB_CONFIG_VERIFY_ON_STARTUP=true
LEGACY_TIME_ZONE=Asia/Seoul
TARGET_DB_ALLOWED_CIDRS=127.0.0.1/32,::1/128
# prod=3306; local target container is published on 13306.
TARGET_DB_ALLOWED_PORTS=3306,13306
TARGET_DB_TLS_REQUIRED=false
TRUSTED_PROXY_CIDRS=

# Part C: realtime and Web Push. Slack webhooks are registered through the
# management API and have no environment variable.
RISK_ENABLED=false
REALTIME_ENABLED=false
NOTIFICATIONS_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
PUSH_ALLOWED_HOSTS=

# Safe Redis Stream retention: minimum 24h, preserve pending/unread boundaries.
APP_REDIS_STREAM_RETENTION_ENABLED=true
APP_REDIS_STREAM_RETENTION_INTERVAL_MS=60000
