# Key and format reference only. The backend does not load .env files.
# Inject values through the process, IDE, or deployment secret provider.

SPRING_PROFILES_ACTIVE=<local|staging|prod>
PUBLIC_ORIGIN=<origin-without-path-or-trailing-slash>

SPRING_DATASOURCE_URL=<jdbc:postgresql://host:port/database>
SPRING_DATASOURCE_USERNAME=<runtime-database-user>
SPRING_DATASOURCE_PASSWORD=<secret>

SPRING_REDIS_HOST=<redis-host>
SPRING_REDIS_PORT=<redis-port>
SPRING_REDIS_PASSWORD=<secret; empty-only-for-loopback-local>

# Part B runtime contract.
JWT_SIGNING_KEYS=<json-object-kid-to-base64-key>
JWT_ACTIVE_KID=<kid>
DB_CONFIG_ENCRYPTION_KEYS=<json-object-version-to-base64-32-byte-key>
DB_CONFIG_ACTIVE_KEY_VERSION=<integer>
DB_CONFIG_VERIFY_ON_STARTUP=<true|false>
AUTH_SECURE_COOKIES=<true|false>
BOOTSTRAP_ADMIN_EMAIL=<email>
BOOTSTRAP_ADMIN_PASSWORD=<secret>
BOOTSTRAP_ADMIN_DISPLAY_NAME=<display-name>
TARGET_DB_ALLOWED_CIDRS=<comma-separated-cidrs>
TARGET_DB_ALLOWED_PORTS=<comma-separated-ports>
TARGET_DB_TLS_REQUIRED=<true|false>
TRUSTED_PROXY_CIDRS=<comma-separated-cidrs>

# Part C runtime contract.
WEB_PUSH_VAPID_PUBLIC_KEY=<base64url-p256-public-key>
WEB_PUSH_VAPID_PRIVATE_KEY=<base64url-p256-private-key>
WEB_PUSH_VAPID_SUBJECT=<mailto-address>
PUSH_ALLOWED_HOSTS=<comma-separated-hosts>
REALTIME_ENABLED=<true|false>

APP_COLLECTOR_ENABLED=<true|false>
APP_COLLECTOR_FIXED_RATE_MS=<milliseconds>
APP_METRICS_RETENTION_DAYS=<1-365>
LEGACY_TIME_ZONE=<iana-zone-for-existing-localdatetime-data>
