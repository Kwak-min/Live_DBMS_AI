# Live_DBMS_AI backend environment variables
# Copy this file to `.env` and fill in real values for your local/deploy environment.
# `.env` itself is gitignored — never commit real secrets.

# Local development only. Production must not use the local profile because it disables target DB TLS.
SPRING_PROFILES_ACTIVE=local

# ── Part A: System DB (PostgreSQL) ──────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/monitoring_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ── Part A: Redis (event streams) ───────────────────────────────
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# ── Part B: Auth / RBAC / credential encryption ────────────────
# JSON object: kid -> base64 secret. Never commit actual key material.
JWT_SIGNING_KEYS=
JWT_ACTIVE_KID=
# JSON object: integer version -> base64-encoded exactly 32-byte AES key.
DB_CONFIG_ENCRYPTION_KEYS=
DB_CONFIG_ACTIVE_KEY_VERSION=
PUBLIC_ORIGIN=http://localhost:5173
AUTH_SECURE_COOKIES=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=

# Flyway is enabled and Hibernate ddl-auto is validate in application.yml.
# Pre-Flyway local databases created by ddl-auto=update need the backend/README migration procedure.
DB_CONFIG_VERIFY_ON_STARTUP=true
LEGACY_TIME_ZONE=Asia/Seoul
TARGET_DB_ALLOWED_CIDRS=
TARGET_DB_ALLOWED_PORTS=3306
TRUSTED_PROXY_CIDRS=

# ── Part C: Notifications (not yet implemented) ─────────────────
# Web Push (VAPID) keypair for mobile web push.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Messenger webhook endpoint for incident alerts.
NOTIFICATION_WEBHOOK_URL=
